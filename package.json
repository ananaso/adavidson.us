{
	"name": "adavidson.us",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "bun run build && ./scripts/deploy.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"quality": "npm run lint && npm run format",
		"lint": "eslint . --fix",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"autoprefixer": "^10.6.1",
		"clsx": "^2.1.1",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4"
	},
	"type": "module"
}
